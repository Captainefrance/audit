---
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
import { t, type Lang } from "../i18n";
import type { ResolvedGraph } from "../lib/architecture";
import type { ResolvedScenario } from "../lib/scenarios";

interface Props {
  lang: Lang;
  graph: ResolvedGraph;
  scenarios: ResolvedScenario[];
}
const { lang, graph, scenarios } = Astro.props;

// Un mode n'apparaît que s'il a au moins un scénario visible ; « Panne » est toujours proposé.
const modes = [
  ...(scenarios.some((s) => s.mode === "attack") ? (["attack"] as const) : []),
  ...(scenarios.some((s) => s.mode === "flow") ? (["flow"] as const) : []),
  "outage" as const,
];

const tools = graph.layers.flatMap((l) => l.tools);
const names: Record<string, string> = {};
for (const tool of tools) names[tool.id] = tool.name;
for (const ext of graph.externals) names[ext.id] = ext.name;

const sim = {
  lang,
  modes,
  scenarios,
  names,
  linkLabels: Object.fromEntries(graph.linkTypes.map((l) => [l.type, l.label])),
  outage: {
    deps: Object.fromEntries(tools.filter((tl) => tl.dependsOn.length > 0).map((tl) => [tl.id, tl.dependsOn])),
    failable: [...tools.map((tl) => tl.id), ...graph.externals.filter((e) => e.canFail).map((e) => e.id)],
  },
  i18n: {
    play: t(lang, "sim.play"),
    pause: t(lang, "sim.pause"),
    restart: t(lang, "sim.restart"),
    step: t(lang, "sim.step"),
    links: t(lang, "sim.links"),
    outageCount: t(lang, "sim.outage.count"),
    outageNone: t(lang, "sim.outage.none"),
    outageDown: t(lang, "sim.outage.down"),
    outageCascade: t(lang, "sim.outage.cascade"),
  },
};
// JSON inerte (type application/json) : pas exécuté, donc sans effet sur la CSP. `<` échappé.
const simJson = JSON.stringify(sim).replace(/</g, "\\u003c");

const btn =
  "rounded-full border border-slate-light bg-white px-4 py-1.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-disabled:cursor-default aria-disabled:opacity-40 aria-disabled:hover:border-slate-light aria-disabled:hover:text-ink";
---

<section class="mt-16" data-sim aria-labelledby="sim-title">
  <h2 id="sim-title" class="text-2xl font-semibold tracking-tight text-ink">{t(lang, "sim.title")}</h2>

  <div class="sim-ui mt-6" data-sim-ui>
    <div role="tablist" aria-label={t(lang, "sim.mode.label")} class="flex flex-wrap gap-2" data-sim-tabs>
      {
        modes.map((mode, i) => (
          <button
            type="button"
            role="tab"
            id={`sim-tab-${mode}`}
            data-mode={mode}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls="sim-panel"
            tabindex={i === 0 ? 0 : -1}
            class="sim-tab rounded-full border border-slate-light px-4 py-1.5 text-sm text-slate transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-selected:border-accent aria-selected:bg-accent-soft aria-selected:text-accent"
          >
            {t(lang, `sim.mode.${mode}`)}
          </button>
        ))
      }
    </div>

    <div id="sim-panel" role="tabpanel" aria-labelledby={`sim-tab-${modes[0]}`} class="mt-6">
      <!-- Modes attaque / flux -->
      <div data-sim-scenario-ui hidden>
        <div role="group" aria-label={t(lang, "sim.scenario.label")} class="mb-4 flex flex-wrap gap-2" data-sim-chooser hidden>
          {
            scenarios.map((s) => (
              <button type="button" data-scenario={s.id} data-mode={s.mode} aria-pressed="false" hidden class={btn + " aria-pressed:border-accent aria-pressed:text-accent"}>
                {s.title}
              </button>
            ))
          }
        </div>
        <p class="text-lg font-semibold tracking-tight text-ink" data-sim-title></p>
        <p class="mt-1 max-w-2xl text-slate" data-sim-description hidden></p>

        <div class="mt-4 flex flex-wrap items-center gap-3" role="group" aria-label={t(lang, "sim.region")}>
          <button type="button" data-sim-prev class={btn}>‹ {t(lang, "sim.prev")}</button>
          <button type="button" data-sim-play class={btn}>{t(lang, "sim.play")}</button>
          <button type="button" data-sim-next class={btn}>{t(lang, "sim.next")} ›</button>
          <span class="text-sm text-slate" data-sim-count></span>
          <span class="sim-tag hidden rounded bg-accent-soft px-2 py-0.5 text-xs text-accent" data-sim-tag></span>
        </div>
        <div
          class="sim-progress mt-3"
          data-sim-progress
          role="progressbar"
          aria-label={t(lang, "sim.progress")}
          aria-valuemin="1"
          aria-valuemax="1"
          aria-valuenow="1"
        >
          <span class="sim-progress-bar" data-sim-bar></span>
        </div>
        <p class="mt-3 text-xs text-slate">{t(lang, "sim.keys")}</p>

        <!-- Caption (≥ md) : espace réservé, pas de saut de mise en page entre les étapes. -->
        <div class="sim-caption mt-4 hidden min-h-[5.5rem] md:block" data-sim-caption aria-live="polite">
          <p class="max-w-2xl text-ink" data-sim-caption-text></p>
          <p class="mt-2 text-sm text-slate" data-sim-caption-links></p>
        </div>
      </div>

      <!-- Mode panne -->
      <div data-sim-outage-ui hidden>
        <p class="max-w-2xl text-slate">{t(lang, "sim.outage.hint")}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="button" data-sim-reset class={btn}>{t(lang, "sim.outage.reset")}</button>
          <p class="text-sm text-slate" data-sim-status role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="mt-6">
        <ArchitectureDiagram
          lang={lang}
          layers={graph.layers}
          externals={graph.externals}
          links={graph.links}
          linkTypes={graph.linkTypes}
          mode="player"
          idPrefix="sim"
        />
      </div>
    </div>
  </div>

  <script type="application/json" id="sim-data" set:html={simJson} />
</section>
