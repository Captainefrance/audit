---
import { localePath, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  id: string;
  name: string;
  category: string;
  /** Chemin sans locale de la fiche ; absent = carte sans lien. */
  href?: string;
  draft?: boolean;
}
const { lang, id, name, category, href, draft = false } = Astro.props;
---

<article
  transition:name={href ? `tool-${id}` : undefined}
  class:list={[
    "reveal-on-scroll relative flex h-full flex-col rounded-lg border border-slate-light bg-white p-5",
    href ? "spotlight transition-colors focus-within:border-accent hover:border-accent" : "",
  ]}
>
  <p class="text-xs text-slate">
    {category}
    {draft && <span class="ml-2 rounded bg-accent-soft px-1.5 py-0.5 text-accent">{t(lang, "news.draft")}</span>}
  </p>
  <h4 class="mt-2 text-lg font-semibold tracking-tight text-ink">
    {
      href ? (
        <a
          href={localePath(lang, href)}
          class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {name}
        </a>
      ) : (
        name
      )
    }
  </h4>
  {!href && <p class="mt-auto pt-4 text-xs text-slate">{t(lang, "architecture.no_page")}</p>}
</article>
