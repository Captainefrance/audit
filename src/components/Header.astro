---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localePath, splitLocale, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path?: string;
}
const { lang, path } = Astro.props;

const navItems = [
  { path: "/", label: t(lang, "nav.home") },
  { path: "/a-propos", label: t(lang, "nav.about") },
];

const current = splitLocale(Astro.url.pathname).rest.replace(/\/$/, "") || "/";
---

<header class="border-b border-slate-light">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-5"
  >
    <a
      href={localePath(lang)}
      class="whitespace-nowrap text-sm font-semibold tracking-tight text-ink"
    >
      audit-hq<span class="text-accent">.dev</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <nav aria-label={t(lang, "nav.label")}>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            navItems.map((item) => {
              const isActive =
                item.path === "/"
                  ? current === "/"
                  : current.startsWith(item.path);
              return (
                <li>
                  <a
                    href={localePath(lang, item.path)}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "transition-colors hover:text-accent",
                      isActive ? "text-accent font-medium" : "text-slate",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      {path !== undefined && <LanguageSwitcher lang={lang} path={path} />}
    </div>
  </div>
</header>
