---
import { localePath, t, type Lang } from "../i18n";
import ExternalCard from "./ExternalCard.astro";
import LayerCard from "./LayerCard.astro";
import LinkLegend from "./LinkLegend.astro";
import type { LinkType } from "../data/architecture";
import type { ResolvedExternal, ResolvedGraph, ResolvedLayer } from "../lib/architecture";

interface Props {
  lang: Lang;
  layers: ResolvedLayer[];
  externals?: ResolvedExternal[];
  links?: ResolvedGraph["links"];
  linkTypes?: ResolvedGraph["linkTypes"];
  /**
   * "static" : schéma complet (SVG ≥ md, liste verticale en dessous).
   * "scrolly" : SVG seul, piloté par src/scripts/architecture-scrolly.ts (les couches
   * mobiles sont rendues par la page, avec leur texte).
   * "player" : schéma de simulation (sans liens hypertexte), piloté par src/scripts/sequence-engine.ts ;
   * SVG ≥ md, liste verticale en dessous (mêmes `data-node`).
   */
  mode?: "static" | "scrolly" | "player";
  /** Préfixe des ids SVG (titre, marqueurs) : unique si plusieurs schémas sur la page. */
  idPrefix?: string;
  /** Couche mise en évidence (fiche outil). */
  highlightLayer?: string;
  /** Outil mis en évidence (fiche outil). */
  highlightTool?: string;
}
const {
  lang,
  layers,
  externals = [],
  links = [],
  linkTypes = [],
  mode = "static",
  idPrefix = "arch",
  highlightLayer,
  highlightTool,
} = Astro.props;
const player = mode === "player";

// Géométrie du schéma (unités du viewBox).
const W = 800;
const PAD = 16; // marge intérieure d'une couche
const LABEL_H = 22; // hauteur du titre de couche
const NODE_H = 48;
const NODE_GAP = 12;
const LAYER_GAP = 44; // espace entre couches (contient la flèche)
const nodeWidth = (name: string, category: string) =>
  Math.min(300, Math.max(130, Math.max(name.length * 8.4, category.length * 6.6) + 32));
const externalLabel = t(lang, "architecture.external");

interface PlacedNode {
  id: string;
  name: string;
  category: string;
  href?: string;
  x: number;
  y: number;
  w: number;
  layerIndex: number; // -1 pour un nœud externe
  external?: ResolvedExternal;
}

const placeExternals = (list: ResolvedExternal[], top: number): PlacedNode[] => {
  const widths = list.map((e) => nodeWidth(e.name, externalLabel));
  const total = widths.reduce((s, w) => s + w, 0) + Math.max(0, list.length - 1) * NODE_GAP;
  let x = (W - total) / 2;
  return list.map((e, i) => {
    const node: PlacedNode = { id: e.id, name: e.name, category: externalLabel, x, y: top, w: widths[i], layerIndex: -1, external: e };
    x += widths[i] + NODE_GAP;
    return node;
  });
};

const topExternals = externals.filter((e) => e.placement === "top");
const bottomExternals = externals.filter((e) => e.placement === "bottom");

let y = 0;
let topNodes: PlacedNode[] = [];
if (topExternals.length > 0) {
  topNodes = placeExternals(topExternals, y);
  y += NODE_H + LAYER_GAP;
}
const placed = layers.map((layer, layerIndex) => {
  const rows: { tool: ResolvedLayer["tools"][number]; w: number }[][] = [[]];
  let rowW = 0;
  for (const tool of layer.tools) {
    const w = nodeWidth(tool.name, tool.category);
    const current = rows[rows.length - 1];
    if (current.length > 0 && rowW + NODE_GAP + w > W - 2 * PAD) {
      rows.push([]);
      rowW = 0;
    }
    rows[rows.length - 1].push({ tool, w });
    rowW += (rowW > 0 ? NODE_GAP : 0) + w;
  }
  const rowCount = layer.tools.length === 0 ? 0 : rows.length;
  const height = PAD + LABEL_H + rowCount * NODE_H + Math.max(0, rowCount - 1) * NODE_GAP + PAD;
  const top = y;
  y += height + LAYER_GAP;
  const nodes: PlacedNode[] = rows.flatMap((row, r) => {
    const total = row.reduce((s, n) => s + n.w, 0) + (row.length - 1) * NODE_GAP;
    let x = (W - total) / 2;
    return row.map(({ tool, w }) => {
      const node: PlacedNode = {
        id: tool.id,
        name: tool.name,
        category: tool.category,
        href: tool.href,
        x,
        y: top + PAD + LABEL_H + r * (NODE_H + NODE_GAP),
        w,
        layerIndex,
      };
      x += w + NODE_GAP;
      return node;
    });
  });
  return { layer, top, height, nodes, layerIndex };
});
let bottomNodes: PlacedNode[] = [];
if (bottomExternals.length > 0) {
  bottomNodes = placeExternals(bottomExternals, y);
  y += NODE_H + LAYER_GAP;
}
const H = Math.max(0, y - LAYER_GAP);
const label = t(lang, "architecture.diagram.label");
const allNodes = [...topNodes, ...placed.flatMap((p) => p.nodes), ...bottomNodes];

// Liens : courbes entre nœuds, sous les nœuds. Sans liens déclarés, flèches entre couches.
const byId = new Map(allNodes.map((n) => [n.id, n]));
const edgePath = (a: PlacedNode, b: PlacedNode) => {
  if (a.layerIndex === b.layerIndex && a.y === b.y) {
    const rightward = a.x < b.x;
    const x1 = rightward ? a.x + a.w : a.x;
    const x2 = rightward ? b.x - 3 : b.x + b.w + 3;
    const cy = a.y + NODE_H / 2;
    return `M${x1} ${cy} L${x2} ${cy}`;
  }
  const down = b.y > a.y;
  const x1 = a.x + a.w / 2;
  const y1 = down ? a.y + NODE_H : a.y;
  const x2 = b.x + b.w / 2;
  const y2 = down ? b.y - 4 : b.y + NODE_H + 4;
  const my = (y1 + y2) / 2;
  return `M${x1} ${y1} C${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
};
const edges = links
  .map((l) => ({ ...l, a: byId.get(l.from), b: byId.get(l.to) }))
  .filter((e): e is typeof e & { a: PlacedNode; b: PlacedNode } => Boolean(e.a && e.b))
  .map((e) => ({
    from: e.from,
    to: e.to,
    type: e.type,
    d: edgePath(e.a, e.b),
    revealIndex: Math.max(e.a.layerIndex, e.b.layerIndex),
  }));
const usedTypes = [...new Set(edges.map((e) => e.type))] as LinkType[];
const typesForLegend = linkTypes.length > 0 ? linkTypes : [];
const titleId = `${idPrefix}-title`;
const descId = `${idPrefix}-desc`;
const hasList = mode === "static" || player;
---

<div class:list={["architecture-diagram", mode === "static" && "reveal-on-scroll"]} data-diagram data-mode={mode}>
  <!-- ≥ md : schéma SVG -->
  <svg
    class="hidden h-auto w-full md:block"
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-labelledby={titleId}
    aria-describedby={descId}
  >
    <title id={titleId}>{label}</title>
    <desc id={descId}>{t(lang, "architecture.diagram.desc")}</desc>
    <defs>
      <marker id={`${idPrefix}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-link)"></path>
      </marker>
      {
        usedTypes.map((type) => (
          <marker id={`${idPrefix}-arrow-${type}`} class={`marker-${type}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M0 0 L10 5 L0 10 z"></path>
          </marker>
        ))
      }
    </defs>

    {
      placed.map(({ layer, top, height, layerIndex }, i) => (
        <g data-layer={layer.id} data-layer-index={layerIndex} data-reveal-index={layerIndex}>
          <rect
            class="layer-rect"
            x="1"
            y={top}
            width={W - 2}
            height={height}
            rx="14"
            fill="var(--diagram-layer-fill)"
            stroke={layer.id === highlightLayer ? "var(--diagram-highlight)" : "var(--diagram-layer-stroke)"}
            stroke-width={layer.id === highlightLayer ? 2.5 : 1.5}
          ></rect>
          <text
            class="layer-label"
            x={PAD + 4}
            y={top + PAD + 6}
            font-size="13"
            font-weight="600"
            fill={layer.id === highlightLayer ? "var(--diagram-highlight)" : "var(--diagram-text-muted)"}
          >
            {layer.name}
          </text>
          {links.length === 0 && i < placed.length - 1 && (
            <line
              data-reveal-index={layerIndex + 1}
              x1={W / 2}
              y1={top + height + 4}
              x2={W / 2}
              y2={top + height + LAYER_GAP - 4}
              stroke="var(--diagram-link)"
              stroke-width="1.5"
              marker-end={`url(#${idPrefix}-arrow)`}
            ></line>
          )}
        </g>
      ))
    }

    {
      edges.map((e) => (
        <path
          class={`link-line link-${e.type}`}
          d={e.d}
          data-link
          data-from={e.from}
          data-to={e.to}
          data-type={e.type}
          data-reveal-index={e.revealIndex}
          marker-end={`url(#${idPrefix}-arrow-${e.type})`}
        ></path>
      ))
    }

    {
      allNodes.map((node) => {
        const { x, y: ny, w, layerIndex, external } = node;
        const current = node.id === highlightTool;
        const body = (
          <>
            <rect
              class:list={["node-box", external && "node-external", external && `kind-${external.kind}`]}
              x={x}
              y={ny}
              width={w}
              height={NODE_H}
              rx={external ? NODE_H / 2 : 10}
              fill={external ? "var(--diagram-external-fill)" : "var(--diagram-node-fill)"}
              stroke={current ? "var(--diagram-highlight)" : external ? undefined : "var(--diagram-node-stroke)"}
              stroke-width={external ? 2 : 2.5}
            ></rect>
            <text x={x + w / 2} y={ny + 21} text-anchor="middle" font-size="14" font-weight="600" fill="var(--diagram-text)">
              {node.name}
            </text>
            <text x={x + w / 2} y={ny + 38} text-anchor="middle" font-size="11" fill="var(--diagram-text-muted)">
              {" "}{node.category}
            </text>
            <path class="down-mark" d={`M${x + w - 24} ${ny + 8} l12 12 m0 -12 l-12 12`}></path>
          </>
        );
        return node.href && !player ? (
          <a
            class="node node-link"
            href={localePath(lang, node.href)}
            data-node={node.id}
            data-reveal-index={layerIndex}
            aria-current={current ? "page" : undefined}
          >
            {body}
          </a>
        ) : (
          <g
            class="node"
            data-node={node.id}
            data-external={external ? external.kind : undefined}
            data-reveal-index={layerIndex}
            aria-label={external ? `${node.name} (${externalLabel})` : `${node.name} — ${node.category}`}
            role="img"
          >
            {body}
          </g>
        );
      })
    }
  </svg>

  <div class="hidden md:block">
    <LinkLegend lang={lang} linkTypes={typesForLegend} />
  </div>

  <!-- < md : liste verticale (static et player ; en scrolly, la page rend les couches avec leur texte) -->
  {
    hasList && (
      <ol class="space-y-4 md:hidden" aria-label={label}>
        {topExternals.length > 0 && (
          <li>
            <ExternalCard lang={lang} externals={topExternals} player={player} />
          </li>
        )}
        {layers.map((layer) => (
          <li>
            <LayerCard lang={lang} layer={layer} highlightLayer={highlightLayer} highlightTool={highlightTool} player={player} />
          </li>
        ))}
        {bottomExternals.length > 0 && (
          <li>
            <ExternalCard lang={lang} externals={bottomExternals} player={player} />
          </li>
        )}
      </ol>
    )
  }
</div>

<style>
  .architecture-diagram svg {
    font-family: var(--font-sans);
  }
  .architecture-diagram .node-link {
    cursor: pointer;
  }
  .architecture-diagram .node-link:hover .node-box {
    stroke: var(--diagram-highlight);
  }
  .architecture-diagram .node-link:focus-visible {
    outline: 2px solid var(--diagram-highlight);
    outline-offset: 3px;
    border-radius: 10px;
  }
</style>
