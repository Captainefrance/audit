---
import { localePath, type Lang } from "../i18n";
import type { ResolvedLayer } from "../lib/architecture";

interface Props {
  lang: Lang;
  layer: ResolvedLayer;
  highlightLayer?: string;
  highlightTool?: string;
}
const { lang, layer, highlightLayer, highlightTool } = Astro.props;
const current = layer.id === highlightLayer;
---

<div
  class:list={["rounded-lg border-2 p-4", current ? "border-accent" : "border-slate-light"]}
  aria-current={current ? "true" : undefined}
>
  <p class:list={["text-sm font-semibold", current ? "text-accent" : "text-slate"]}>
    {layer.name}
  </p>
  <ul class="mt-3 space-y-2">
    {
      layer.tools.map((tool) => {
        const isTool = tool.id === highlightTool;
        const cls = ["block rounded-lg bg-accent-soft px-3 py-2 text-sm", isTool ? "outline-2 outline-accent" : ""];
        return (
          <li>
            {tool.href ? (
              <a
                href={localePath(lang, tool.href)}
                aria-current={isTool ? "page" : undefined}
                class:list={[
                  ...cls,
                  "transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                ]}
              >
                <span class="font-semibold">{tool.name}</span>
                <span class="block text-xs text-slate">{tool.category}</span>
              </a>
            ) : (
              <span class:list={cls}>
                <span class="font-semibold">{tool.name}</span>
                <span class="block text-xs text-slate">{tool.category}</span>
              </span>
            )}
          </li>
        );
      })
    }
  </ul>
</div>
