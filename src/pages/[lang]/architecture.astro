---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangStaticPaths, type Lang } from "../../i18n";

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Lang;
---

<BaseLayout title="Architecture" lang={lang} path="/architecture/" translations={["fr"]}>
  <section class="reveal-on-scroll">
    <p class="text-sm font-medium text-accent">Architecture</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Architecture — à venir
    </h1>
    <p class="mt-4 max-w-2xl text-slate">
      Le schéma d'architecture technique sera publié ici.
    </p>
  </section>
</BaseLayout>
