---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArchitectureDiagram from "../../../components/ArchitectureDiagram.astro";
import LayerCard from "../../../components/LayerCard.astro";
import ToolCard from "../../../components/ToolCard.astro";
import { getLangStaticPaths, t, type Lang } from "../../../i18n";
import { getLayerPanels, resolveGraph } from "../../../lib/architecture";

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Lang;
const { layers, links, linkTypes } = await resolveGraph(lang);
const hasContent = layers.some((l) => l.tools.length > 0);

// Scrollytelling seulement si au moins une couche a un texte ; sinon schéma statique complet.
const panelEntries = await getLayerPanels(lang);
const panels = new Map(
  await Promise.all(
    layers
      .filter((l) => panelEntries.has(l.id))
      .map(async (l) => {
        const panel = panelEntries.get(l.id)!;
        const { Content } = await render(panel.entry);
        return [l.id, { Content, contentLang: panel.contentLang }] as const;
      }),
  ),
);
const scrolly = hasContent && panels.size > 0;
---

{
  hasContent ? (
    <BaseLayout title={t(lang, "architecture.title")} lang={lang} path="/architecture/">
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {t(lang, "architecture.title")}
      </h1>

      {scrolly ? (
        <div class="mt-10" data-scrolly>
          <div class="md:grid md:grid-cols-[minmax(0,1fr)_17rem] md:gap-10">
            <div class="scrolly-sticky hidden md:sticky md:top-6 md:block md:self-start">
              <ArchitectureDiagram
                lang={lang}
                layers={layers}
                links={links}
                linkTypes={linkTypes}
                mode="scrolly"
              />
            </div>
            <ol class="space-y-10 md:space-y-0" aria-label={t(lang, "architecture.steps")}>
              {layers.map((layer) => {
                const panel = panels.get(layer.id);
                return (
                  <li
                    data-step
                    data-layer={layer.id}
                    class="scrolly-step md:flex md:min-h-[65vh] md:items-center"
                  >
                    <div class="reveal-on-scroll md:hidden">
                      <LayerCard lang={lang} layer={layer} />
                    </div>
                    {panel && (
                      <div
                        class="scrolly-panel mt-4 max-w-prose md:mt-0"
                        lang={panel.contentLang !== lang ? panel.contentLang : undefined}
                      >
                        <h2 class="text-lg font-semibold tracking-tight text-ink">{layer.name}</h2>
                        <div class="prose-content mt-3 text-ink">
                          <panel.Content />
                        </div>
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        </div>
      ) : (
        <div class="mt-10">
          <ArchitectureDiagram lang={lang} layers={layers} links={links} linkTypes={linkTypes} />
        </div>
      )}

      <section class="mt-16" aria-labelledby="tool-index">
        <h2 id="tool-index" class="text-2xl font-semibold tracking-tight text-ink">
          {t(lang, "architecture.index")}
        </h2>
        <div class="mt-6 space-y-8">
          {layers
            .filter((l) => l.tools.length > 0)
            .map((layer) => (
              <div class="reveal-on-scroll">
                <h3 class="text-sm font-semibold text-slate">{layer.name}</h3>
                <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {layer.tools.map((tool) => (
                    <li>
                      <ToolCard
                        lang={lang}
                        id={tool.id}
                        name={tool.name}
                        category={tool.category}
                        href={tool.href}
                        draft={tool.draft}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="Architecture" lang={lang} path="/architecture/" translations={["fr"]}>
      <section class="reveal-on-scroll">
        <p class="text-sm font-medium text-accent">Architecture</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          Architecture — à venir
        </h1>
        <p class="mt-4 max-w-2xl text-slate">
          Le schéma d'architecture technique sera publié ici.
        </p>
      </section>
    </BaseLayout>
  )
}

<script>
  import "../../../scripts/architecture-scrolly";
</script>
