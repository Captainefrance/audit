---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NewsCard from "../../../components/NewsCard.astro";
import { format, getLangStaticPaths, localePath, t, type Lang } from "../../../i18n";
import { pageTranslations } from "../../../i18n/pages";
import { getNewsEntries, localize, sortByDateDesc } from "../../../lib/collections";

export const getStaticPaths = getLangStaticPaths;
const lang = Astro.params.lang as Lang;

const PAGE_SIZE = 12;
const items = sortByDateDesc(localize(await getNewsEntries(), lang));
const tags = [...new Set(items.flatMap((i) => i.entry.data.tags))].sort((a, b) =>
  a.localeCompare(b, lang),
);
---

<BaseLayout title={t(lang, "news.title")} lang={lang} path="/news/" translations={pageTranslations.news}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`${t(lang, "news.title")} (RSS)`}
    href={localePath(lang, "/news/rss.xml").replace(/\/$/, "")}
  />
  <section
    data-news
    data-page-size={PAGE_SIZE}
    data-count-template={t(lang, "news.count")}
    data-page-template={t(lang, "news.page")}
  >
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {t(lang, "news.title")}
      </h1>
      <a
        href={localePath(lang, "/news/rss.xml").replace(/\/$/, "")}
        class="text-sm text-slate transition-colors hover:text-accent"
      >
        {t(lang, "news.rss")}
      </a>
    </div>

    {
      items.length === 0 ? (
        <p class="mt-10 text-slate">{t(lang, "news.empty")}</p>
      ) : (
        <>
          {tags.length > 0 && (
            <div class="mt-8" data-news-filter>
              <p class="text-sm text-slate" id="news-filter-label">
                {t(lang, "news.filter.label")}
              </p>
              <ul class="mt-2 flex flex-wrap gap-2" aria-labelledby="news-filter-label">
                {[null, ...tags].map((tag) => (
                  <li>
                    <button
                      type="button"
                      data-tag={tag ?? ""}
                      aria-pressed={tag === null ? "true" : "false"}
                      class="rounded-full border border-slate-light px-3 py-1 text-sm text-slate transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                    >
                      {tag ?? t(lang, "news.filter.all")}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p class="mt-6 text-sm text-slate" data-news-status role="status" aria-live="polite">
            {format(t(lang, "news.count"), { n: items.length })}
          </p>

          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {items.map(({ entry, slug }) => (
              <li>
                <NewsCard
                  lang={lang}
                  slug={slug}
                  title={entry.data.title}
                  date={entry.data.date}
                  sourceName={entry.data.source.name}
                  tags={entry.data.tags}
                  draft={entry.data.draft}
                />
              </li>
            ))}
          </ul>

          <nav
            class="mt-10 flex items-center justify-center gap-4 text-sm"
            aria-label={t(lang, "news.pagination")}
            data-news-pagination
            hidden
          >
            <button type="button" data-prev class="rounded-full border border-slate-light px-4 py-1.5 text-slate transition-colors hover:border-accent hover:text-accent disabled:opacity-40 disabled:hover:border-slate-light disabled:hover:text-slate focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              {t(lang, "news.prev")}
            </button>
            <span data-page-label class="text-slate"></span>
            <button type="button" data-next class="rounded-full border border-slate-light px-4 py-1.5 text-slate transition-colors hover:border-accent hover:text-accent disabled:opacity-40 disabled:hover:border-slate-light disabled:hover:text-slate focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              {t(lang, "news.next")}
            </button>
          </nav>
        </>
      )
    }
  </section>
</BaseLayout>

<style is:global>
  /* Réserve la place du filtre avant que le JS ne l'active (pas de décalage de mise en page). */
  [data-news-filter]:not([data-ready]) {
    visibility: hidden;
  }
  @media (scripting: none) {
    [data-news-filter] {
      display: none;
    }
  }
</style>

<script>
  import "../../../scripts/news-filter";
</script>
