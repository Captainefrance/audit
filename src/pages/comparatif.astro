---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Comparatif d'outils" noindex>
  <section class="reveal-on-scroll">
    <p class="text-sm font-medium text-accent">Comparatif</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Comparatif d'outils — à venir
    </h1>
    <p class="mt-4 max-w-2xl text-slate">
      Le comparatif des outils (PAM, EDR, SIEM, IAM, backup, réseau...) sera
      publié ici.
    </p>
  </section>
</BaseLayout>
